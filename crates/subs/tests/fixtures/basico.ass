[Script Info]
; Fixture del slice 0b. ASCII a proposito: aisla geometria y alfa de cualquier
; problema de codificacion de texto.
;
; PlayResX/Y iguales al tamano del frame de prueba (1920x1080), asi libass
; rasteriza 1:1 y las coordenadas se pueden comparar con las del oraculo.
ScriptType: v4.00+
PlayResX: 1920
PlayResY: 1080
WrapStyle: 0
ScaledBorderAndShadow: yes

[V4+ Styles]
Format: Name, Fontname, Fontsize, PrimaryColour, SecondaryColour, OutlineColour, BackColour, Bold, Italic, Underline, StrikeOut, ScaleX, ScaleY, Spacing, Angle, BorderStyle, Outline, Shadow, Alignment, MarginL, MarginR, MarginV, Encoding
; ASS usa AABBGGRR. &H00FFFFFF = blanco opaco; &H000000FF = rojo opaco.
Style: Base,Arial,64,&H00FFFFFF,&H000000FF,&H00000000,&H80000000,0,0,0,0,100,100,0,0,1,3,0,2,60,60,60,1
Style: Rojo,Arial,72,&H000000FF,&H00FFFFFF,&H00000000,&H80000000,-1,0,0,0,100,100,0,0,1,3,2,5,60,60,60,1

[Events]
Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, Text
Dialogue: 0,0:00:00.50,0:00:03.00,Base,,0,0,0,,Subtitulo de prueba
Dialogue: 1,0:00:00.50,0:00:03.00,Rojo,,0,0,0,,{\pos(960,300)}Arriba centrado
